# ──────────────────────────────────────────────
# 나만의 리멤버 — 환경변수 설정 파일
# ──────────────────────────────────────────────
# 이 파일을 복사하여 .env.local 로 이름을 바꾼 뒤,
# 각 값을 실제 키로 교체하세요.
#
#   cp .env.local.example .env.local
#
# .env.local 파일은 Git에 올라가지 않으므로 안전합니다.
# ──────────────────────────────────────────────

# ── Firebase 설정 ──
# Firebase 콘솔(https://console.firebase.google.com) →
# 프로젝트 설정 → 일반 → 내 앱 → Firebase SDK snippet 에서 복사
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Gemini AI API 키 ──
# Google AI Studio(https://aistudio.google.com/apikey) 에서 발급
# 서버에서만 사용되며 클라이언트에 노출되지 않습니다
GEMINI_API_KEY=your_gemini_api_key

# ── Gmail API 자동 전송 (인사 이메일) ──
# Google Cloud Console → APIs & Services → Credentials 에서 "Web 클라이언트 ID" 복사.
# 같은 프로젝트에서 Firebase Google 로그인 OAuth 클라이언트를 재사용합니다.
# 설정 방법:
#   1. https://console.cloud.google.com → 프로젝트 선택 (Firebase와 동일)
#   2. APIs & Services → Library → "Gmail API" 검색 → Enable
#   3. OAuth consent screen → Scopes → gmail.send 추가
#   4. Credentials → 기존 Web 클라이언트 ID → Authorized origins 에
#      http://localhost:3000, 프로덕션 URL 추가
#   5. Client ID를 아래에 붙여넣기
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# ── EmailJS 설정 (인사 이메일 폴백 — 선택) ──
# Gmail API 미설정 시 Gmail 작성창을 대신 열기 위한 값 (아래 비워도 됨)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
